    "highPriorityFindings": 0,
    "findingsTotal": 23,
    "dispositions": {
      "USO_UNSAFE_METHOD_SYNCHRONIZATION": "Intentional public registry synchronization; factories are trusted in-process code and must be fast. No tenant isolation is promised for hostile in-process plugins.",
      "RV_RETURN_VALUE_IGNORED_NO_SIDE_EFFECT": "Timeline conversion is intentionally called for its overflow exception before state mutation; overflow oracle verifies atomic rejection.",
      "BC_VACUOUS_INSTANCEOF": "Netty future sync can rethrow checked bind failures through an unchecked path; the Error-vs-other branch preserves fatal errors and wraps checked failures. Bind/fatal-cleanup regressions exercise both.",
      "CWO_CLOSED_WITHOUT_OPENED": "Ownership crosses Processor/AsyncEmitter SPI boundaries; terminal-resource oracle checks each registered resource closes once.",
      "DE_MIGHT_IGNORE": "Best-effort body close at timeout; timeout state is recorded before close and the caller observes failure. Deterministic close-race test verifies it.",
      "UPM_UNCALLED_PRIVATE_METHOD": "Frame interface private helpers are invoked by nested records; constructor validation tests cover those calls.",
      "THROWS_*": "The open processing/cleanup SPI deliberately permits checked provider errors and fatal cleanup aggregation.",
      "REC_CATCH_EXCEPTION": "Branch wrapper preserves the named branch context and original failure; sibling cancellation is tested."
    },
    "limitations": "Static patterns are not exhaustive correctness or security evidence. Remaining warnings are retained in the report, not suppressed to produce a zero-warning badge."
